{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cv-pro-team-clients",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cv-pro-team-clients-db",
      "database_id": "ea8f8415-e50b-43e3-a97b-1e9490042f61",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "cv-pro-team-clients-files"
    }
  ],
  "observability": {
    "enabled": true
  }
}
