    <hr:PartyName>Owner</hr:PartyName>
    <PersonContact><PersonName><oa:GivenName>Amine</oa:GivenName><hr:FamilyName>Bensalem</hr:FamilyName></PersonName><Communication><ChannelCode>Email</ChannelCode><oa:URI>amine.bensalem@example.com</oa:URI></Communication></PersonContact>
    <hr:PrecedenceCode>1</hr:PrecedenceCode>
  </CandidateSupplier>
  <CandidatePerson>
    <PersonName><oa:GivenName>Amine</oa:GivenName><hr:FamilyName>Bensalem</hr:FamilyName></PersonName>
    <Communication><ChannelCode>Email</ChannelCode><oa:URI>amine.bensalem@example.com</oa:URI></Communication><Communication><ChannelCode>Telephone</ChannelCode><UseCode>mobile</UseCode><CountryDialing>1</CountryDialing><oa:DialNumber>4385551842</oa:DialNumber><CountryCode>ca</CountryCode></Communication><Communication><UseCode>home</UseCode><Address type="home"><oa:AddressLine>Montréal, QC, Canada</oa:AddressLine><oa:CityName>Montréal</oa:CityName><CountryCode>ca</CountryCode></Address></Communication>
    
    <hr:BirthDate>1992-03-15</hr:BirthDate>
    
    
    <PrimaryLanguageCode name="NORMAL">ara</PrimaryLanguageCode>
  </CandidatePerson>
  <CandidateProfile languageCode="fr">
    <hr:ID schemeID="ZGR-6b150156" schemeName="CandidateProfileID" schemeAgencyName="EUROPASS" schemeVersionID="1.0" />
    <hr:ExecutiveSummary>&lt;p&gt;Ingénieur logiciel full-stack motivé, fort de plusieurs années d&apos;expérience en &lt;strong&gt;développement web&lt;/strong&gt; et en intégration d&apos;API, souhaitant contribuer à des projets innovants au sein d&apos;une entreprise canadienne axée sur la qualité, la collaboration et l&apos;amélioration continue.&lt;/p&gt;</hr:ExecutiveSummary>
    <EmploymentHistory><EmployerHistory>
        <hr:OrganizationName>TechNova Solutions, Montréal</hr:OrganizationName>
        <OrganizationContact><Communication><Address><oa:CityName>Montréal</oa:CityName><CountryCode>ca</CountryCode></Address></Communication></OrganizationContact>
        
        <PositionHistory>
          <PositionTitle typeCode="FREETEXT">Développeur logiciel full-stack</PositionTitle>
          <eures:EmploymentPeriod><eures:StartDate><hr:FormattedDateTime>2022-06-01</hr:FormattedDateTime></eures:StartDate><eures:EndDate><hr:FormattedDateTime>2025-10-01</hr:FormattedDateTime></eures:EndDate><hr:CurrentIndicator>false</hr:CurrentIndicator></eures:EmploymentPeriod>
          <oa:Description>&lt;ul&gt;&lt;li&gt;Concevoir, développer et maintenir des applications web SaaS en React et Node.js pour des clients nord-américains&lt;/li&gt;&lt;li&gt;Mettre en place des API REST sécurisées et documentées, intégrées à des services tiers et à des bases de données PostgreSQL&lt;/li&gt;&lt;li&gt;Collaborer avec les équipes produit, QA et UX dans un environnement Agile pour livrer des fonctionnalités incrémentales de haute qualité&lt;/li&gt;&lt;li&gt;Contribuer au processus de revue de code, au mentorat des développeurs juniors et à l&apos;amélioration continue des standards de développement&lt;/li&gt;&lt;/ul&gt;</oa:Description>
          <City>Montréal</City><Country>ca</Country>
        </PositionHistory>
        
      </EmployerHistory><EmployerHistory>
        <hr:OrganizationName>DigitalDZ Studio, Alger</hr:OrganizationName>
        <OrganizationContact><Communication><Address><oa:CityName>Alger</oa:CityName><CountryCode>dz</CountryCode></Address></Communication></OrganizationContact>
        
        <PositionHistory>
          <PositionTitle typeCode="FREETEXT">Développeur web</PositionTitle>
          <eures:EmploymentPeriod><eures:StartDate><hr:FormattedDateTime>2019-01-01</hr:FormattedDateTime></eures:StartDate><eures:EndDate><hr:FormattedDateTime>2022-05-01</hr:FormattedDateTime></eures:EndDate><hr:CurrentIndicator>false</hr:CurrentIndicator></eures:EmploymentPeriod>
          <oa:Description>&lt;ul&gt;&lt;li&gt;Développer des sites et applications web sur mesure en JavaScript, PHP et Laravel pour des PME locales&lt;/li&gt;&lt;li&gt;Participer à l&apos;analyse des besoins des clients et à la rédaction des spécifications fonctionnelles et techniques&lt;/li&gt;&lt;li&gt;Optimiser les performances front-end et back-end afin d&apos;améliorer l&apos;expérience utilisateur et le référencement naturel&lt;/li&gt;&lt;li&gt;Assurer la maintenance applicative, la correction de bugs et l&apos;évolution de fonctionnalités selon les retours clients&lt;/li&gt;&lt;/ul&gt;</oa:Description>
          <City>Alger</City><Country>dz</Country>
        </PositionHistory>
        
      </EmployerHistory><EmployerHistory>
        <hr:OrganizationName>Startup InnovIT, Alger</hr:OrganizationName>
        <OrganizationContact><Communication><Address><oa:CityName>Alger</oa:CityName><CountryCode>dz</CountryCode></Address></Communication></OrganizationContact>
        
        <PositionHistory>
          <PositionTitle typeCode="FREETEXT">Stagiaire développeur logiciel</PositionTitle>
          <eures:EmploymentPeriod><eures:StartDate><hr:FormattedDateTime>2017-09-01</hr:FormattedDateTime></eures:StartDate><eures:EndDate><hr:FormattedDateTime>2018-12-01</hr:FormattedDateTime></eures:EndDate><hr:CurrentIndicator>false</hr:CurrentIndicator></eures:EmploymentPeriod>
          <oa:Description>&lt;ul&gt;&lt;li&gt;Participer au développement d&apos;un prototype de plateforme web de gestion de projets internes&lt;/li&gt;&lt;li&gt;Contribuer à l&apos;implémentation de modules front-end en HTML, CSS et JavaScript moderne&lt;/li&gt;&lt;li&gt;Rédiger une documentation technique de base pour faciliter la reprise et l&apos;évolution du code par l&apos;équipe&lt;/li&gt;&lt;li&gt;Collaborer avec l&apos;équipe de recherche pour tester différentes approches d&apos;architecture logicielle&lt;/li&gt;&lt;/ul&gt;</oa:Description>
          <City>Alger</City><Country>dz</Country>
        </PositionHistory>
        
      </EmployerHistory><EmployerHistory>
        <hr:OrganizationName>Auto-entrepreneur</hr:OrganizationName>
        <OrganizationContact><Communication><Address><oa:CityName>Alger</oa:CityName><CountryCode>dz</CountryCode></Address></Communication></OrganizationContact>
        
        <PositionHistory>
          <PositionTitle typeCode="FREETEXT">Développeur freelance</PositionTitle>
          <eures:EmploymentPeriod><eures:StartDate><hr:FormattedDateTime>2016-06-01</hr:FormattedDateTime></eures:StartDate><eures:EndDate><hr:FormattedDateTime>2017-08-01</hr:FormattedDateTime></eures:EndDate><hr:CurrentIndicator>false</hr:CurrentIndicator></eures:EmploymentPeriod>
          <oa:Description>&lt;ul&gt;&lt;li&gt;Réaliser des petits sites vitrines et des applications internes pour des commerçants et associations locales&lt;/li&gt;&lt;li&gt;Gérer l&apos;ensemble du cycle de vie des projets, de la collecte des besoins à la mise en production&lt;/li&gt;&lt;li&gt;Assurer le support technique de base et la formation des utilisateurs finaux&lt;/li&gt;&lt;li&gt;Maintenir une relation client de proximité en proposant des améliorations régulières et adaptées&lt;/li&gt;&lt;/ul&gt;</oa:Description>
          <City>Alger</City><Country>dz</Country>
        </PositionHistory>
        
