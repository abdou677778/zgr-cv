{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zgr-cv-storage-api",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://abdou677778.github.io,http://localhost:4173,http://localhost:5173,null",
    "ADMIN_USERNAME": "admin",
    "CLIENT_PORTAL_API_URL": "https://cv-pro-team-clients.zgrcv-wizi.workers.dev",
  },
  "r2_buckets": [
    {
      "binding": "CLIENTS_BUCKET",
      "bucket_name": "zgr-cv-clients",
    },
  ],
  "services": [
    {
      "binding": "CLIENT_PORTAL_SERVICE",
      "service": "cv-pro-team-clients",
    },
  ],
}
