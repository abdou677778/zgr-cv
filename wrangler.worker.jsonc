{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zgr-cv-storage-api",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": "./dist-spa",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://abdou677778.github.io,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,null",
    "ADMIN_USERNAME": "admin",
    "CLIENT_PORTAL_API_URL": "https://cv-pro-team-clients.zgrcv-wizi.workers.dev",
  },
  "r2_buckets": [
    {
      "binding": "CLIENTS_BUCKET",
      "bucket_name": "zgr-cv-clients",
    },
  ],
  "services": [
    {
      "binding": "CLIENT_PORTAL_SERVICE",
      "service": "cv-pro-team-clients",
    },
  ],
}
